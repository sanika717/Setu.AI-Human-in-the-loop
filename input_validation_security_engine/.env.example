# Copy this file to input_validation_security_engine/.env and fill in real values.
# input_validation_security_engine/config.py calls load_dotenv() with no explicit
# path, which searches upward from this package's own directory - so this
# file works regardless of the directory you launch uvicorn from.

APP_NAME="Document Validation Engine"
API_VERSION=v1
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser.
# "*" is fine for local development only.
ALLOWED_ORIGINS=*

# --- Metadata validation limits ------------------------------------------
MAX_FILE_SIZE_BYTES=5242880
MAX_PAGE_COUNT=10
# Comma-separated list of accepted MIME types.
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/jpg,image/png

# --- OCR input validation limits ------------------------------------------
MIN_OCR_TEXT_LENGTH=10
MAX_OCR_TEXT_LENGTH=20000
MIN_ALNUM_RATIO_PERCENT=30

# --- Official Service Registry -------------------------------------------
# Required-document and eligibility pre-checks are fetched from here.
REGISTRY_BASE_URL=http://127.0.0.1:8004
REGISTRY_TIMEOUT_SECONDS=5
