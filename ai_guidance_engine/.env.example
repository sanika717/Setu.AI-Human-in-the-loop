# Copy this file to ai_guidance_engine/.env and fill in real values.
# ai_guidance_engine/config.py calls load_dotenv() with no explicit path,
# which searches upward from this package's own directory - so this file
# works regardless of the directory you launch uvicorn from.

APP_NAME="AI Extraction Engine"
API_VERSION=v1
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser.
# "*" is fine for local development only.
ALLOWED_ORIGINS=*

# Which provider create_provider() uses when the caller doesn't specify one.
# One of: gemini, openai, claude, azure (or azure_openai), ollama.
DEFAULT_PROVIDER=gemini

REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=0.5
RETRY_BACKOFF_MAX_SECONDS=8

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenAI ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Claude (Anthropic) ------------------------------------------------
# Either name works; CLAUDE_API_KEY is checked first, then ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_API_VERSION=2023-06-01

# --- Azure OpenAI --------------------------------------------------------
# All three of these are required together for the Azure provider to work.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Ollama (local, no API key required) --------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Risk Engine (Phase D Security Shield) --------------------------------
# Used to content-scan AI-generated extraction output for sensitive-field
# indicators (OTP/password/PIN/CVV) before it is returned to any caller.
# If risk_engine is unreachable, extraction fails OPEN (same choice
# system_orchestrator makes for redirects) and logs the failure loudly -
# set CONTENT_SCAN_ENABLED=false to disable the call entirely (e.g. for a
# unit test environment with no risk_engine running).
RISK_ENGINE_BASE_URL=http://127.0.0.1:8005
RISK_ENGINE_TIMEOUT_SECONDS=3
CONTENT_SCAN_ENABLED=true
