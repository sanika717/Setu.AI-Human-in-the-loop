# Copy this file to system_orchestrator/app/.env and fill in real values.
# system_orchestrator/app/core/config.py loads env vars from exactly that path
# (os.path.dirname(__file__)/../.env), regardless of the directory you
# launch uvicorn from.

APP_NAME="AI Assistant Backend"

# Defaults to a SQLite file inside system_orchestrator/app/ (backend_dev.db) if unset,
# so this service runs with zero setup. Point this at Postgres (with an
# async driver) for production, e.g.:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_assistant
DATABASE_URL=

# Used to sign/verify anything requiring a server-side secret. Generate a
# real random value for any non-local deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=supersecretkey

# Used by system_orchestrator/app/services/provider_client.py + extraction_service.py
# for the /extract and /evaluate endpoints on this service (separate from
# ai_guidance_engine's own provider configuration).
OPENAI_API_KEY=

# Comma-separated list of origins allowed to call this API from a browser.
# "*" is fine for local development only.
ALLOWED_ORIGINS=*

# Used by system_orchestrator/app/utils/crypto.py to encrypt any documents a user
# explicitly opts to have retained (Phase G: zero-retention by default).
# Generate a real Fernet key for any non-local deployment, e.g.:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_RETRIES=2
PROVIDER_FALLBACK=true

# Official Service Registry (official_service_registry) - source of truth
# for the /portals catalog. See app/services/registry_client.py.
REGISTRY_BASE_URL=http://127.0.0.1:8004
REGISTRY_TIMEOUT_SECONDS=5.0

# Risk Engine (risk_engine) - Phase D Security Shield check called from
# POST /portals/confirm before a redirect is handed back to the browser.
# See app/services/risk_client.py.
RISK_ENGINE_BASE_URL=http://127.0.0.1:8005
RISK_ENGINE_TIMEOUT_SECONDS=5.0

# Intent Service (intent_service, Phase C1-C4) - text-only intent
# classification, service resolution, multilingual support, and multi-turn
# conversation. system_orchestrator is the single integration point between
# the frontend and intent_service; see app/services/intent_client.py and
# POST/GET/DELETE /api/v1/conversation/*.
INTENT_SERVICE_BASE_URL=http://127.0.0.1:8006
INTENT_SERVICE_TIMEOUT_SECONDS=5.0
