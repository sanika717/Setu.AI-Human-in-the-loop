# Copy this file to intent_service/.env and fill in real values.
# intent_service/config.py calls load_dotenv() with no explicit path, which
# searches upward from this package's own directory - so this file works
# regardless of the directory you launch uvicorn from.

APP_NAME="Intent Service"
API_VERSION=v1
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser.
# "*" is fine for local development only.
ALLOWED_ORIGINS=*

# Which IntentClassifier implementation to use. "keyword" is the only one
# registered today (Phase C1) - it needs no external API and no network.
INTENT_CLASSIFIER=keyword

# Below this confidence (share of total keyword score across all intents),
# the top-scoring intent is reported as "unclassified" rather than guessed
# at. Raise this to be more conservative; lower it to reduce "unclassified"
# results at the cost of more low-confidence guesses.
INTENT_MIN_CONFIDENCE=0.2

# Phase C2: Official Service Registry - source of the live service catalog
# POST /api/v1/intent/resolve ranks against.
REGISTRY_BASE_URL=http://127.0.0.1:8004
REGISTRY_TIMEOUT_SECONDS=5.0

# Maximum number of ranked service candidates /intent/resolve returns.
INTENT_MAX_SERVICE_MATCHES=3

# Phase C4: conversation layer (POST /api/v1/conversation/message).
# How long (seconds) an idle conversation session is kept in memory before
# it's treated as gone.
CONVERSATION_SESSION_TTL_SECONDS=1800.0

# How many consecutive turns the conversation will keep asking "what do you
# need help with" before giving up and reporting needs_human_help.
CONVERSATION_MAX_CLARIFICATION_ATTEMPTS=3

# How many consecutive unmatched replies during "which service did you
# mean" disambiguation before the top-ranked candidate is used automatically.
CONVERSATION_MAX_DISAMBIGUATION_ATTEMPTS=3

# How many consecutive unparseable answers to the same follow-up question
# before that field is recorded as unknown and the conversation moves on.
CONVERSATION_MAX_FIELD_ATTEMPTS=3

# When /intent/resolve returns more than one candidate service, the top
# candidate is accepted automatically (skipping disambiguation) only if its
# match_confidence leads the runner-up by at least this much.
CONVERSATION_DISAMBIGUATION_CONFIDENCE_GAP=0.34
