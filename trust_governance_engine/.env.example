# Copy this file to trust_governance_engine/.env and fill in real values.
# trust_governance_engine/config.py calls load_dotenv() with no explicit path,
# which searches upward from this package's own directory - so this file
# works regardless of the directory you launch uvicorn from.

APP_NAME="Human Decision & Governance Engine"
API_VERSION=v1
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser.
# "*" is fine for local development only.
ALLOWED_ORIGINS=*

# This engine keeps its own database, independent of system_orchestrator/app's. Defaults
# to a SQLite file inside this package's own directory (governance.db) if
# unset - safe regardless of the working directory the process is launched
# from. Point this at Postgres for production, e.g.:
#   DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/governance
DATABASE_URL=

# --- OTP settings ----------------------------------------------------------
OTP_CODE_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Mixed into the OTP hash alongside a per-challenge random salt. MUST be
# overridden to a real random secret in any non-local deployment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_HASH_PEPPER=dev-only-otp-pepper-change-me
# When true (the local/dev default), the generated OTP code is echoed back
# in the /otp/request response so the flow can be exercised without a real
# SMS/e-mail provider. Set to false as soon as a real OTPDeliveryProvider is
# wired in (see services/otp_service.py).
OTP_DEV_MODE_EXPOSE_CODE=true

# Whether an intake field is treated as required when the caller doesn't
# say so explicitly.
FIELD_REQUIRED_BY_DEFAULT=true
