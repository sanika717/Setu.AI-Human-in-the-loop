# Copy this file to official_service_registry/.env and fill in real values.
# official_service_registry/config.py calls load_dotenv() with no explicit
# path, which searches upward from this package's own directory - so this
# file works regardless of the directory you launch uvicorn from.

APP_NAME="Official Service Registry"
API_VERSION=v1
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser.
# "*" is fine for local development only.
ALLOWED_ORIGINS=*

# Absolute or relative path to the canonical service catalog. Defaults to
# the bundled official_service_registry/data/services.json. Point this at an
# externally-managed file (e.g. mounted from a config-map in production) to
# add/edit services without redeploying code.
# SERVICES_CONFIG_PATH=/etc/sahaay/services.json
