# Copy this file to risk_engine/.env and fill in real values.
# risk_engine/config.py calls load_dotenv() with no explicit path, which
# searches upward from this package's own directory - so this file works
# regardless of the directory you launch uvicorn from.

APP_NAME="Risk Engine"
API_VERSION=v1
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser.
# "*" is fine for local development only.
ALLOWED_ORIGINS=*

# Official Service Registry - source of truth for each service's
# official_url + allowed_domains whitelist used by the domain-whitelist
# check in POST /api/v1/risk/redirect-check.
REGISTRY_BASE_URL=http://127.0.0.1:8004
REGISTRY_TIMEOUT_SECONDS=5.0
